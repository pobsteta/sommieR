# Niveau rapide (ADR 0001 amendée le 2026-11-16) : sous 600 s pour le hook ; la suite complete reste en CI (r.yml, job `tests`).
# Regle : INCLUSION des fichiers tests/testthat/test-*.R mesures un par un le 2026-11-17 (base PostGIS sommier_test_b jointe) qui tiennent en moins de 120 s chacun
# (somme mesuree : 317 s, R relance a chaque fichier). Inclusion plutot qu'exclusion : un nouveau fichier lent ne fait pas deborder le budget ; a ajouter ici apres mesure.
# Hors du niveau rapide (plus de 120 s mesures, tous des tests de base) : amenagement-db, carte-db, comptabilite, concurrence-db, croquis-db, db, demo-quarto,
# detections-db, elements-pci, export-db, geometrie-db, limites-db, nemeton, patrimoine-db, registre-imprime-db.
# Les tests de base rapides y sont (reprise, travaux-db, travaux-qfield-db, visa-db) : la commande ECHOUE si la base n'est pas jointe au lieu de sauter, comme la CI.
Rscript -e 'res <- devtools::test(filter = "^(cms|contrat_nemeton|demo-marsannay|der|empreinte|entree|especes|fond|geometrie|horodatage|jcs|jws|limites|manifeste|parametres|pci|proprietes|registre1|registre6|registre7|registre8|registres-2349|registres|reprise|sensibilite|sql-decoupage|sql|travaux-db|travaux-qfield-db|symbologie-travaux|travaux-reprise|verifier|visa-db)$", reporter = "summary", stop_on_failure = FALSE); plat <- as.data.frame(res); ech <- sum(plat$failed) + sum(plat$error); mot <- unlist(lapply(res, function(f) vapply(f$results, function(r) if (inherits(r, "expectation_skip")) conditionMessage(r) else "", character(1)))); sb <- grep("Aucune base PostgreSQL", mot, value = TRUE); cat("echecs:", ech, " sauts pour base injoignable:", length(sb), "\n"); if (length(sb)) { cat("La base de test (SOMMIER_TEST_DB) n est pas jointe : un vert obtenu en sautant les tests de base est trompeur.\n"); quit(status = 1) }; if (ech > 0) quit(status = 1)'
