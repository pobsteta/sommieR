        <constraint field="element_id" desc="Un constat répond à un élément du plan, sauf « Hors plan »." exp="(&quot;type_element&quot; = 'hors_plan' AND &quot;element_id&quot; IS NULL) OR (&quot;type_element&quot; &lt;> 'hors_plan' AND &quot;element_id&quot; IS NOT NULL)"/>
        <constraint field="etat" desc="L'état doit être choisi dans la liste du type d'élément." exp="CASE WHEN &quot;type_element&quot; = 'point' THEN &quot;etat&quot; IN ('en_place', 'endommage', 'non_retrouve', 'detruit', 'inaccessible') WHEN &quot;type_element&quot; = 'ligne' THEN &quot;etat&quot; IN ('visible', 'partiellement_visible', 'peu_visible', 'non_visible', 'inaccessible') WHEN &quot;type_element&quot; = 'surface' THEN &quot;etat&quot; IN ('conforme', 'modifiee', 'degradee', 'disparue', 'inaccessible') WHEN &quot;type_element&quot; = 'hors_plan' THEN &quot;etat&quot; IN ('hors_plan') ELSE FALSE END"/>
