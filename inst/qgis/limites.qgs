      <defaults>
        <default field="fid" expression="" applyOnUpdate="0"/>
        <default field="uuid" expression="uuid('WithoutBraces')" applyOnUpdate="0"/>
        <default field="type_element" expression="with_variable('dp', coalesce(distance($geometry, array_first(overlay_nearest('limites_elements_points', $geometry, limit:=1, max_distance:=30))), 9999), with_variable('dl', coalesce(distance($geometry, array_first(overlay_nearest('limites_elements_lignes', $geometry, limit:=1, max_distance:=30))), 9999), with_variable('ds', coalesce(distance($geometry, boundary(array_first(overlay_nearest('limites_elements_surfaces', $geometry, limit:=1, max_distance:=30)))), 9999), CASE WHEN @dp = 9999 AND @dl = 9999 AND @ds = 9999 THEN NULL WHEN @dp &lt;= 2 OR (@dp &lt;= @dl AND @dp &lt;= @ds) THEN 'point' WHEN @dl &lt;= @ds THEN 'ligne' ELSE 'surface' END)))" applyOnUpdate="0"/>
        <default field="element_id" expression="CASE WHEN &quot;type_element&quot; IS NULL OR &quot;type_element&quot; = 'hors_plan' THEN NULL WHEN &quot;element_id&quot; IS NOT NULL AND attribute(get_feature('limites_elements', 'id', &quot;element_id&quot;), 'forme') = &quot;type_element&quot; THEN &quot;element_id&quot; WHEN &quot;type_element&quot; = 'point' THEN array_first(overlay_nearest('limites_elements_points', &quot;id&quot;, limit:=1, max_distance:=30)) WHEN &quot;type_element&quot; = 'ligne' THEN array_first(overlay_nearest('limites_elements_lignes', &quot;id&quot;, limit:=1, max_distance:=30)) WHEN &quot;type_element&quot; = 'surface' THEN array_first(overlay_nearest('limites_elements_surfaces', &quot;id&quot;, limit:=1, max_distance:=30)) END" applyOnUpdate="1"/>
        <default field="etat" expression="CASE WHEN &quot;type_element&quot; = 'hors_plan' THEN 'hors_plan' WHEN CASE WHEN &quot;type_element&quot; = 'point' THEN &quot;etat&quot; IN ('en_place', 'endommage', 'non_retrouve', 'detruit', 'inaccessible') WHEN &quot;type_element&quot; = 'ligne' THEN &quot;etat&quot; IN ('visible', 'partiellement_visible', 'peu_visible', 'non_visible', 'inaccessible') WHEN &quot;type_element&quot; = 'surface' THEN &quot;etat&quot; IN ('conforme', 'modifiee', 'degradee', 'disparue', 'inaccessible') WHEN &quot;type_element&quot; = 'hors_plan' THEN &quot;etat&quot; IN ('hors_plan') ELSE FALSE END THEN &quot;etat&quot; END" applyOnUpdate="1"/>
        <default field="visite_le" expression="now()" applyOnUpdate="0"/>
        <default field="operateur" expression="@operateur" applyOnUpdate="0"/>
        <default field="precision_m" expression="@position_horizontal_accuracy" applyOnUpdate="0"/>
        <default field="source_gnss" expression="@position_source_name" applyOnUpdate="0"/>
        <default field="observations" expression="" applyOnUpdate="0"/>
      </defaults>
